# ==============================================
# Qwen Proxy v2 - Environment Configuration
# ==============================================

# ----------------------------------------------
# Server Configuration
# ----------------------------------------------

# Port for the HTTP server
PORT=3000

# ----------------------------------------------
# Qwen Credentials (Local Development)
# ----------------------------------------------

# Path to cookies.txt file (Netscape cookie format)
# Capture from browser DevTools - see QUICK-START.md
QWEN_COOKIES_FILE=./cookies.txt

# Path to headers.json file (optional but recommended)
# Contains bx-ua and bx-umidtoken headers
# Improves request success rate
QWEN_HEADERS_FILE=./headers.json

# ----------------------------------------------
# Qwen Credentials (Render/Production Deployment)
# ----------------------------------------------
# Use base64-encoded credentials for cloud deployment
# To generate: base64 -w 0 cookies.txt > cookies.b64
#
# Choose ONE approach:
# - Local development: Use QWEN_COOKIES_FILE + QWEN_HEADERS_FILE
# - Cloud deployment: Use COOKIES_B64 + HEADERS_B64

# Base64-encoded cookies.txt content
# COOKIES_B64=

# Base64-encoded headers.json content
# HEADERS_B64=

# ----------------------------------------------
# Supabase Database Configuration
# ----------------------------------------------
# Required for authentication and analytics
# Get these from: https://supabase.com/dashboard/project/_/settings/api

# Your Supabase project URL
# Format: https://xxxxxxxxxxxxx.supabase.co
# SUPABASE_URL=

# Supabase service role key (NOT the anon key)
# This key bypasses RLS and has full database access
# Keep this secret and never commit it to git
# Format: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_SERVICE_KEY=

# ----------------------------------------------
# Proxy Configuration (Optional)
# ----------------------------------------------
# Use if you need to route requests through a proxy
# Supports HTTP and HTTPS proxies

# Proxy URL with optional authentication
# Examples:
#   - http://proxy.example.com:8080
#   - http://user:pass@proxy.example.com:8080
#   - socks5://proxy.example.com:1080
# PROXY_URL=

# ----------------------------------------------
# Notes
# ----------------------------------------------
#
# 1. NEVER commit .env file to git (already in .gitignore)
# 2. Qwen credentials expire periodically - recapture when needed
# 3. Service role key gives full database access - keep secure
# 4. For Render deployment, use base64-encoded credentials
# 5. If Supabase not configured, authentication is disabled
#
# For detailed setup instructions, see:
# - QUICK-START.md (capturing Qwen credentials)
# - README.md (full configuration guide)
# - DEPLOYMENT-READY.md (production deployment)
